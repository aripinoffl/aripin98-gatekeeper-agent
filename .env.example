# Proof Gatekeeper agent — environment configuration.
# Copy to .env / export in your shell. NEVER commit a real secret.

# REQUIRED. HMAC secret issued by the Agent Games platform for this agent
# (dashboard -> agent -> Rotate Secret; copy the one-time plaintext).
# The server refuses to start without it. Also used to derive the per-task
# circuit salt, so it must stay stable for the agent's lifetime.
AGENT_GAMES_HMAC_SECRET=

# Optional. Port to listen on. Default: 8787
# PORT=8787

# Optional. Directory holding gatekeeper.wasm + gatekeeper_final.zkey.
# Default: <agent dir>/circuits
# CIRCUITS_DIR=/path/to/circuits

# Optional. JSON file for the proof_tx seen-set + task_id response cache.
# Default: <agent dir>/data/seen.json
# SEEN_STORE_PATH=/path/to/seen.json
